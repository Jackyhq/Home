---
import { getBuildMetadata } from '../lib/build-metadata';
import { siteConfig } from '../config/site';
import { isEnglish, localeSite, siteContent } from '../i18n';

const {
  buildYear,
  buildDateIso,
  buildDateLabel,
  commitSha,
  shortCommitSha,
  commitUrl,
} = getBuildMetadata();
const displayedBuildDate = isEnglish
  ? new Intl.DateTimeFormat('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(`${buildDateIso}T00:00:00Z`))
  : buildDateLabel;
---

<footer class:list={['site-footer', { 'site-footer--without-icp': isEnglish }]}>
  <p>
    © {buildYear}
    <a
      href={`${localeSite.url}/`}
    >{siteConfig.name}</a>
  </p>

  {
    !isEnglish && (
      <a
        class="icp-record"
        href="https://beian.miit.gov.cn/"
        target="_blank"
        rel="noopener noreferrer"
      >{siteConfig.icpRecord}</a>
    )
  }

  <div class="footer-links">
    <a
      class="footer-build-link"
      href={commitUrl}
      target="_blank"
      rel="noopener noreferrer"
      title={`${siteContent.footer.commitTitle} ${commitSha}`}
    ><span>{siteContent.footer.buildLabel}{isEnglish && ' '}<time datetime={buildDateIso}>{displayedBuildDate}</time> ({shortCommitSha})</span></a>
  </div>
</footer>
