{
  "name": "home",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.22 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm check && pnpm build:zh && pnpm build:en",
    "build:zh": "SITE_LOCALE=zh-CN astro build",
    "build:en": "SITE_LOCALE=en astro build",
    "deploy:check": "pnpm test:unit && pnpm docs:check",
    "deploy:cf": "pnpm photos:sync && pnpm deploy:check && pnpm check:en && pnpm build:en",
    "deploy:esa": "pnpm photos:sync && pnpm deploy:check && pnpm check:zh && pnpm build:zh",
    "deploy:vercel": "pnpm deploy:esa",
    "preview": "astro preview",
    "check": "pnpm check:zh && pnpm check:en",
    "check:zh": "SITE_LOCALE=zh-CN astro check",
    "check:en": "SITE_LOCALE=en astro check",
    "docs:check": "node scripts/check-doc-links.mjs",
    "photos:sync": "tsx scripts/sync-featured-photos.ts",
    "test": "pnpm test:unit && pnpm test:e2e && pnpm test:e2e:en",
    "test:unit": "tsx --test scripts/lib/dependency-security.test.ts scripts/lib/editor-security.test.ts scripts/lib/photos-manifest.test.ts scripts/lib/read-limited-response.test.ts src/lib/photo-layout.test.ts src/lib/photos.test.ts",
    "pretest:e2e": "pnpm build",
    "test:e2e": "playwright test",
    "test:e2e:dist": "playwright test",
    "test:e2e:en": "PLAYWRIGHT_DIST_DIR=dist-en PLAYWRIGHT_SITE_LOCALE=en playwright test tests/localization.spec.ts",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:photo": "playwright test --grep @photography"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@iconify-json/ph": "^1.2.2",
    "astro": "^7.4.2",
    "astro-icon": "^1.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
